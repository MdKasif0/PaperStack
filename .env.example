# Canonical site URL without a trailing slash, e.g. https://paperstack.netlify.app
# Used for metadata, canonical URLs, sitemap and feeds in later steps.
NEXT_PUBLIC_SITE_URL=

# Optional. Newsletter provider identifier (e.g. "buttondown" | "mailchimp").
# Leave unset to hide/disable the newsletter signup.
NEWSLETTER_PROVIDER=

# Netlify Blobs
# -------------
# No access key is required when the site runs on Netlify: the site ID and
# token are injected automatically by the platform (likewise for `netlify dev`).
# Only set NETLIFY_SITE_ID and a Netlify API token explicitly if you ever call
# Blobs from outside Netlify infrastructure.
